# Required: CallMissed API key (server-side only, never exposed to the browser)
CALLMISSED_API_KEY=cm_your_key_here

# Optional: global daily spend ceiling in credits (1 credit = ₹1 ≈ $0.0104). Default 250.
DAILY_CREDIT_BUDGET=250

# Optional: secret for signing voice-session tickets. Defaults to deriving from the API key.
SESSION_SECRET=
